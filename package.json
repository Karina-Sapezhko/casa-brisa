{
  "name": "casa-brisa",
  "version": "1.0.0",
  "private": true,
  "description": "A single-page hotel portfolio concept on Milos",
  "scripts": {
    "check": "node scripts/check.mjs && node --test tests/*.test.cjs",
    "format": "prettier --write \"dist/*.{html,css,js}\" \"scripts/*.mjs\" \"tests/*.cjs\" README.md package.json .prettierrc.json",
    "format:check": "prettier --check \"dist/*.{html,css,js}\" \"scripts/*.mjs\" \"tests/*.cjs\" README.md package.json .prettierrc.json"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
